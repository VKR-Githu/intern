# NeuraWrite — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.

# OpenAI API Key (optional — app works in demo mode without it)
OPENAI_API_KEY=your_openai_api_key_here

# Server port (if running a backend)
PORT=5000

# MongoDB connection string (if using a database)
MONGODB_URI=mongodb://localhost:27017/neurawrite

# Node environment
NODE_ENV=development
